\@writefile{lot}{\contentsline {table}{\numberline {S13}{\ignorespaces Primary signed diagnostic metrics for the ItemKNN target-margin analysis. This is a descriptive diagnostic summary; the confirmatory inferential targets are the paired comparisons in Table\nonbreakingspace \ref {tab:paired-full}. Direction accuracy (main-manuscript Eq.\nonbreakingspace 17) and top-$3$ precision use signed bounded effects, Precision@3 is the compound positive-and-correct-direction metric defined in main-manuscript Section\nonbreakingspace 4.3, signed alignment is the Spearman correlation $\rho _S(-\phi ^g_{u,p},\Delta ^{z,\mathrm  {bnd}}_{u,p})$ between predicted benefits and bounded effects (seed-averaged per user, 10,000-draw bootstrap CIs), and stability is rank stability across the five seed runs. Direction accuracy and signed alignment are different quantities: the former is the fraction of non-zero effects whose sign is predicted correctly; the latter is a rank correlation over all players.}}{24}{table.caption.9}\protected@file@percent }
\newlabel{tab:app-diagnostics}{{S13}{24}{Primary signed diagnostic metrics for the ItemKNN target-margin analysis. This is a descriptive diagnostic summary; the confirmatory inferential targets are the paired comparisons in Table~\ref {tab:paired-full}. Direction accuracy (main-manuscript Eq.~17) and top-$3$ precision use signed bounded effects, Precision@3 is the compound positive-and-correct-direction metric defined in main-manuscript Section~4.3, signed alignment is the Spearman correlation $\rho _S(-\phi ^g_{u,p},\Delta ^{z,\mathrm {bnd}}_{u,p})$ between predicted benefits and bounded effects (seed-averaged per user, 10,000-draw bootstrap CIs), and stability is rank stability across the five seed runs. Direction accuracy and signed alignment are different quantities: the former is the fraction of non-zero effects whose sign is predicted correctly; the latter is a rank correlation over all players}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S14}{\ignorespaces Complete declared paired family for bounded AIA on the primary conditions: paired mean difference with user-bootstrap 95\% CIs, two-sided sign-permutation $p$ and paired $d_z$, Holm-corrected over the family.}}{24}{table.caption.10}\protected@file@percent }
\newlabel{tab:paired-full}{{S14}{24}{Complete declared paired family for bounded AIA on the primary conditions: paired mean difference with user-bootstrap 95\% CIs, two-sided sign-permutation $p$ and paired $d_z$, Holm-corrected over the family}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S15}{\ignorespaces Primary-cohort success and abstention proportions and paired quality difference against the popularity reference (Pop.), all on the 1,000-user primary ItemKNN cohort (993 on Amazon after constant-vector exclusion), seed-averaged within user with 10,000-draw user-bootstrap 95\% CIs. Success is the fraction of users with positive seed-averaged realized NDCG effect; abstention is the fraction selecting no action. These replace the earlier replication-cohort (250-user) proportions so that all quality quantities are cohort-consistent with Table\nonbreakingspace 3.}}{25}{table.caption.11}\protected@file@percent }
\newlabel{tab:prop-quality}{{S15}{25}{Primary-cohort success and abstention proportions and paired quality difference against the popularity reference (Pop.), all on the 1,000-user primary ItemKNN cohort (993 on Amazon after constant-vector exclusion), seed-averaged within user with 10,000-draw user-bootstrap 95\% CIs. Success is the fraction of users with positive seed-averaged realized NDCG effect; abstention is the fraction selecting no action. These replace the earlier replication-cohort (250-user) proportions so that all quality quantities are cohort-consistent with Table~3}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S16}{\ignorespaces Paired sign-permutation tests on user-level success and abstention (primary cohort, seed-averaged indicators), Holm-corrected across the 12-test family. $d$ is the mean paired difference.}}{25}{table.caption.12}\protected@file@percent }
\newlabel{tab:success-abstention-tests}{{S16}{25}{Paired sign-permutation tests on user-level success and abstention (primary cohort, seed-averaged indicators), Holm-corrected across the 12-test family. $d$ is the mean paired difference}{table.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S17}{\ignorespaces Sensitivity and power: hierarchical user$\times $seed cluster-bootstrap CIs for primary bounded AIA means, and minimum detectable paired difference (MDE$_{80}$) for the Shapley--LIME contrast.}}{26}{table.caption.13}\protected@file@percent }
\newlabel{tab:sens-power}{{S17}{26}{Sensitivity and power: hierarchical user$\times $seed cluster-bootstrap CIs for primary bounded AIA means, and minimum detectable paired difference (MDE$_{80}$) for the Shapley--LIME contrast}{table.caption.13}{}}
