\@writefile{lot}{\contentsline {table}{\numberline {S18}{\ignorespaces Replication aggregates per run: exact-Shapley validation of the MC estimator (mean over enumerated users of the per-user maximum absolute error, and mean rank $\rho $), interaction strength relative to singleton effects, additive-vs-realized pair ranking, and bounded/intervention-aware baseline alignment; last column is the prospective (non-target-conditioned) Shapley alignment. $--$ = undefined (constant exact spectrum or constant effect vectors).}}{27}{table.caption.14}\protected@file@percent }
\newlabel{tab:review3}{{S18}{27}{Replication aggregates per run: exact-Shapley validation of the MC estimator (mean over enumerated users of the per-user maximum absolute error, and mean rank $\rho $), interaction strength relative to singleton effects, additive-vs-realized pair ranking, and bounded/intervention-aware baseline alignment; last column is the prospective (non-target-conditioned) Shapley alignment. $--$ = undefined (constant exact spectrum or constant effect vectors)}{table.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S19}{\ignorespaces Extended analyses: unconditional (full-cohort) regret and prospective bounded AIA per explainer (non-target-conditioned audits), followed by point-by-point curves per run: equal-scorer-budget bounded AIA for Monte Carlo Shapley (budget in scored coalitions) and bounded LIME (budget in masks), the $\rho $-response of Monte Carlo Shapley, and the kernel-width ($\kappa $) sensitivity of bounded LIME.}}{27}{table.caption.15}\protected@file@percent }
\newlabel{tab:review3-ext}{{S19}{27}{Extended analyses: unconditional (full-cohort) regret and prospective bounded AIA per explainer (non-target-conditioned audits), followed by point-by-point curves per run: equal-scorer-budget bounded AIA for Monte Carlo Shapley (budget in scored coalitions) and bounded LIME (budget in masks), the $\rho $-response of Monte Carlo Shapley, and the kernel-width ($\kappa $) sensitivity of bounded LIME}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S20}{\ignorespaces SASRec recommendation quality, five seeds; full-catalogue ranking against all unseen items on 1,000 users. Cohort rows use the replication training recipe (cohort-only histories, ten leave-one-out epochs); full-corpus rows train on every eligible user for thirty epochs with the chronological next-item objective. Neither configuration beats popularity, so the SASRec results in Table\nonbreakingspace \ref {tab:review3} demonstrate attribution transfer under a sequential scorer, not competitive recommendation; the quality gate's purpose is precisely to flag this, and the tuning gap is reported as a limitation.}}{27}{table.caption.16}\protected@file@percent }
\newlabel{tab:review5-sasrec-quality}{{S20}{27}{SASRec recommendation quality, five seeds; full-catalogue ranking against all unseen items on 1,000 users. Cohort rows use the replication training recipe (cohort-only histories, ten leave-one-out epochs); full-corpus rows train on every eligible user for thirty epochs with the chronological next-item objective. Neither configuration beats popularity, so the SASRec results in Table~\ref {tab:review3} demonstrate attribution transfer under a sequential scorer, not competitive recommendation; the quality gate's purpose is precisely to flag this, and the tuning gap is reported as a limitation}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S21}{\ignorespaces Exact-Shapley validation of the reverse-paired estimator on enumerable users ($n_u\le 12$): per-user maximum absolute error quantiles, top-2 signed-action Jaccard between exact- and MC-selected actions, and player-level sign-error rate.}}{28}{table.caption.17}\protected@file@percent }
\newlabel{tab:review5-exact-dist}{{S21}{28}{Exact-Shapley validation of the reverse-paired estimator on enumerable users ($n_u\le 12$): per-user maximum absolute error quantiles, top-2 signed-action Jaccard between exact- and MC-selected actions, and player-level sign-error rate}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S22}{\ignorespaces LIME mask-design ablation (ItemKNN, 200 users, target margin): the seeded Bernoulli design with replacement, distinct masks without replacement, and full enumeration where feasible, plus the ridge penalty sweep under the Bernoulli design. Users whose attribution or effect vector is constant are excluded (valid/$n$).}}{28}{table.caption.18}\protected@file@percent }
\newlabel{tab:review5-lime-masks}{{S22}{28}{LIME mask-design ablation (ItemKNN, 200 users, target margin): the seeded Bernoulli design with replacement, distinct masks without replacement, and full enumeration where feasible, plus the ridge penalty sweep under the Bernoulli design. Users whose attribution or effect vector is constant are excluded (valid/$n$)}{table.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S23}{\ignorespaces Profile-model variance components (bounded AIA, 100 users, $M_{\mathrm  {pair}}=100$): fixed model across five attribution seeds versus five model-initialization seeds with fixed attribution.}}{28}{table.caption.19}\protected@file@percent }
\newlabel{tab:review5-variance}{{S23}{28}{Profile-model variance components (bounded AIA, 100 users, $M_{\mathrm {pair}}=100$): fixed model across five attribution seeds versus five model-initialization seeds with fixed attribution}{table.caption.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S24}{\ignorespaces User-level convergence quantiles (100 users per dataset, independent $M_{\mathrm  {pair}}=1000$ reference): median and 5th/25th percentiles of the per-user rank correlation to the reference, median budget-two action Jaccard, and the joint-threshold coverage (fraction of rank-valid users satisfying rank $\ge 0.95$ and Jaccard $\ge 0.80$).}}{28}{table.caption.20}\protected@file@percent }
\newlabel{tab:review5-convergence}{{S24}{28}{User-level convergence quantiles (100 users per dataset, independent $M_{\mathrm {pair}}=1000$ reference): median and 5th/25th percentiles of the per-user rank correlation to the reference, median budget-two action Jaccard, and the joint-threshold coverage (fraction of rank-valid users satisfying rank $\ge 0.95$ and Jaccard $\ge 0.80$)}{table.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S25}{\ignorespaces KernelSHAP baseline (Shapley-kernel weighted least squares with the efficiency constraint) against the reverse-paired Monte Carlo Shapley estimator, bounded AIA, primary ItemKNN conditions, $\rho =0.5$, user-level paired comparison with 10,000-draw bootstrap CIs. KernelSHAP uses 256/512 masks, the same mask budget as the LIME comparison; Monte Carlo Shapley uses $M_{\mathrm  {pair}}=250$ ($T=500$ evaluated orders). Both estimators agree qualitatively: Shapley bounded alignment remains far below LIME ($0.93$/$0.83$) and LOO ($0.98$/$0.85$) under either estimator.}}{28}{table.caption.21}\protected@file@percent }
\newlabel{tab:review7-kernelschap}{{S25}{28}{KernelSHAP baseline (Shapley-kernel weighted least squares with the efficiency constraint) against the reverse-paired Monte Carlo Shapley estimator, bounded AIA, primary ItemKNN conditions, $\rho =0.5$, user-level paired comparison with 10,000-draw bootstrap CIs. KernelSHAP uses 256/512 masks, the same mask budget as the LIME comparison; Monte Carlo Shapley uses $M_{\mathrm {pair}}=250$ ($T=500$ evaluated orders). Both estimators agree qualitatively: Shapley bounded alignment remains far below LIME ($0.93$/$0.83$) and LOO ($0.98$/$0.85$) under either estimator}{table.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S26}{\ignorespaces LightGCN recommendation-quality gate (full-corpus training, tuned: deeper propagation, larger embeddings, higher learning rate, 80 epochs, five seeds). LightGCN is adapted to the protocol's inference-time history-weighting interface (user vector recomputed as the weighted mean of propagated item embeddings). Even after tuning it does not beat the popularity reference on NDCG@10 on either dataset, so---like the SASRec-style replication---it serves as an architecture-applicability cell rather than a competitive-recommender robustness cell.}}{29}{table.caption.22}\protected@file@percent }
\newlabel{tab:review8-lightgcn-quality}{{S26}{29}{LightGCN recommendation-quality gate (full-corpus training, tuned: deeper propagation, larger embeddings, higher learning rate, 80 epochs, five seeds). LightGCN is adapted to the protocol's inference-time history-weighting interface (user vector recomputed as the weighted mean of propagated item embeddings). Even after tuning it does not beat the popularity reference on NDCG@10 on either dataset, so---like the SASRec-style replication---it serves as an architecture-applicability cell rather than a competitive-recommender robustness cell}{table.caption.22}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S27}{\ignorespaces Generalization of the central finding to a graph architecture (LightGCN) and a third dataset (Gowalla location check-ins): bounded AIA per attribution method. Path-matched baselines (finite differences, integrated gradients, bounded LIME) exceed Monte Carlo Shapley on every configuration, replicating the primary ItemKNN pattern.}}{29}{table.caption.23}\protected@file@percent }
\newlabel{tab:review8-generalization}{{S27}{29}{Generalization of the central finding to a graph architecture (LightGCN) and a third dataset (Gowalla location check-ins): bounded AIA per attribution method. Path-matched baselines (finite differences, integrated gradients, bounded LIME) exceed Monte Carlo Shapley on every configuration, replicating the primary ItemKNN pattern}{table.caption.23}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S28}{\ignorespaces Monte Carlo error control at the $n_{\max }=20$ cap: per-user Monte Carlo standard errors of the Shapley values relative to the largest $|\phi |$, and rank correlation between the selected convergence-budget estimate ($M_{\mathrm  {pair}}=250$) and an independent larger-budget reference ($M_{\mathrm  {pair}}=1000$, separate seed stream).}}{29}{table.caption.24}\protected@file@percent }
\newlabel{tab:review8-mcse}{{S28}{29}{Monte Carlo error control at the $n_{\max }=20$ cap: per-user Monte Carlo standard errors of the Shapley values relative to the largest $|\phi |$, and rank correlation between the selected convergence-budget estimate ($M_{\mathrm {pair}}=250$) and an independent larger-budget reference ($M_{\mathrm {pair}}=1000$, separate seed stream)}{table.caption.24}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S29}{\ignorespaces Exhaustive budget-$B$ oracle (all $\le B$ actions enumerated, replacing the greedy lower bound): oracle effect and additive-selection regret, $B=2$ and $B=3$ ($1{,}351$ actions at $n=20$). Additive selection attains low regret at both budgets.}}{29}{table.caption.25}\protected@file@percent }
\newlabel{tab:review8-b3}{{S29}{29}{Exhaustive budget-$B$ oracle (all $\le B$ actions enumerated, replacing the greedy lower bound): oracle effect and additive-selection regret, $B=2$ and $B=3$ ($1{,}351$ actions at $n=20$). Additive selection attains low regret at both budgets}{table.caption.25}{}}
