# Overleaf / latexmk configuration for the SignalShap manuscript.
#
# Overleaf reads this automatically. It pins the engine to pdflatex and
# ensures bibtex (not biber) is used, which is what sn-jnl.cls expects:
# the class calls \bibliographystyle{sn-mathphys-num} and the manuscript
# uses \bibliography{...}, i.e. classic BibTeX, not biblatex.

$pdf_mode = 1;        # pdflatex
$bibtex_use = 2;      # always run bibtex, and clean .bbl on cleanup
$out_dir = '.';
